{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "flutter",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "flutter (mock)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=API_ENV=mock"
            ]
        },
        {
            // 本地联调：直连本地后端（网关 18080）+ IM 厂商对齐 dev nacos。
            // dev 环境 nacos `im.provider: netease`，故客户端须 IM_VENDOR=netease，
            // 否则后端发网易云信凭证、客户端按腾讯登录 → 消息列表永远空。
            // 真机请把 API_BASE_URL 换成 Mac 局域网 IP（模拟器 localhost 即可）。
            "name": "flutter (local dev)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=API_BASE_URL=http://192.168.9.40:18080",
                "--dart-define=IM_VENDOR=netease"
            ]
        },
        {
            "name": "flutter (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "flutter (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}